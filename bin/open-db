#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "$0")" && pwd)
repo_root=$(cd "$script_dir/.." && pwd)
secrets_file=${ZEPHYR_KAMAL_SECRETS_FILE:-$repo_root/.kamal/secrets}
container=${ZEPHYR_POSTGRES_CONTAINER:-zephyr-postgres}
database_user=${ZEPHYR_POSTGRES_USER:-zephyr}
database_name=${ZEPHYR_POSTGRES_DATABASE:-zephyr}
database_port=${ZEPHYR_POSTGRES_PORT:-5432}

for command in docker rainfrog; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "ERROR: Required command not found: $command" >&2
    exit 1
  fi
done

deployment_database_url=
credential_message="enter POSTGRES_PASSWORD when prompted"
if [ -r "$secrets_file" ]; then
  # shellcheck source=/dev/null
  source "$secrets_file"
  if [ -z "${DATABASE_URL:-}" ]; then
    echo "ERROR: DATABASE_URL is missing from $secrets_file" >&2
    exit 1
  fi
  deployment_database_url=$DATABASE_URL
  credential_message="using the private local deployment credential"
fi

# Do not leak unrelated deployment secrets into Rainfrog.
unset KAMAL_REGISTRY_PASSWORD POSTGRES_PASSWORD INGEST_API_KEY DATABASE_URL PGPASSWORD \
  ZEPHYR_TLS_CERTIFICATE_PEM ZEPHYR_TLS_PRIVATE_KEY_PEM

if ! running=$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null); then
  echo "ERROR: PostgreSQL container not found: $container" >&2
  exit 1
fi
if [ "$running" != true ]; then
  echo "ERROR: PostgreSQL container is not running: $container" >&2
  exit 1
fi

database_ip=$(docker inspect \
  --format '{{range .NetworkSettings.Networks}}{{println .IPAddress}}{{end}}' \
  "$container" | awk 'NF { print; exit }')
if [ -z "$database_ip" ]; then
  echo "ERROR: PostgreSQL container has no reachable Docker network address: $container" >&2
  exit 1
fi

echo "Opening $database_name in Rainfrog; $credential_message."
if [ -n "$deployment_database_url" ]; then
  docker_host="@$container:"
  database_url=${deployment_database_url/"$docker_host"/"@$database_ip:"}
  if [ "$database_url" = "$deployment_database_url" ]; then
    echo "ERROR: DATABASE_URL does not target the expected container: $container" >&2
    exit 1
  fi
  export DATABASE_URL=$database_url
  unset deployment_database_url database_url
  exec rainfrog
fi

exec rainfrog \
  --driver postgres \
  --host "$database_ip" \
  --port "$database_port" \
  --username "$database_user" \
  --database "$database_name"
