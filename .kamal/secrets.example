# Kamal dotenv forwarding — copy this file to `.kamal/secrets` (mode 600).
# `.kamal/secrets` is gitignored and must never be committed.
# Load values, including multiline PEMs, from an approved environment/secret source;
# do not paste private-key content into this template or repository.
#
# Usage:
#   cp .kamal/secrets.example .kamal/secrets
#   chmod 600 .kamal/secrets
#   bin/deploy check
# Live deploy/setup remain blocked until TLS publication hardening is installed.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
DATABASE_URL=$DATABASE_URL
INGEST_API_KEY=$INGEST_API_KEY
# Custom TLS inputs are consumed by Kamal, not passed to the application.
ZEPHYR_TLS_CERTIFICATE_PEM=$ZEPHYR_TLS_CERTIFICATE_PEM
ZEPHYR_TLS_PRIVATE_KEY_PEM=$ZEPHYR_TLS_PRIVATE_KEY_PEM
